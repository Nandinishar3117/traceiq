# TraceIQ Global Environment Configuration

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
ANALYTICS_PORT=8000
POSTGRES_PORT=5432
ELASTICSEARCH_PORT=9200

# PostgreSQL
POSTGRES_DB=traceiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_HOST=localhost

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=traceiq-logs

# Analytics Engine
ANALYTICS_SERVICE_URL=http://localhost:8000
ANOMALY_ZSCORE_THRESHOLD=2.0
SLOW_REQUEST_THRESHOLD_MS=800.0

# Ingestion Settings
MAX_BULK_SIZE=500
MAX_FILE_UPLOAD_MB=10
